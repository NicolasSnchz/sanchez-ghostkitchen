---
title: Usuarios y catálogo (dominio.modelo)
config:
  class:
    hideEmptyMembersBox: true
---
classDiagram
    direction TB
    class Usuario {
        <<abstract entity>>
        -id: Long
        -nombre: String
        -correo: String
        -claveCifrada: String
        -fechaRegistro: LocalDateTime
        +rol()* Rol
        +normalizarCorreo(String)$ String
    }
    class Cazador {
        -alias: String
        +validarAlias(String)$ String
        +rol() Rol
    }
    class Administrador {
        +rol() Rol
    }
    class CocinaFantasma["CocinaFantasma [P]"] {
        <<entity, producto del Builder>>
        -id: Long
        -nombre: String
        -descripcion: String
        -categoria: CategoriaCocina
        -rareza: Rareza
        -horaApertura: LocalTime
        -horaCierre: LocalTime
        -canales: Set~CanalPedido~
        -activa: boolean
        -fechaAlta: LocalDate
        +builder()$ Builder
        +estaAbierta(LocalTime) boolean
        +actualizar(Builder) void
        +activar() void
        +desactivar() void
    }
    class Builder["CocinaFantasma.Builder [P]"] {
        <<Builder>>
        +nombre(String) Builder
        +horario(LocalTime, LocalTime) Builder
        +ubicacion(double, double, String) Builder
        +canal(CanalPedido) Builder
        +build() CocinaFantasma
    }
    class Ubicacion {
        <<embeddable>>
        -latitud: double
        -longitud: double
        -barrio: String
        +distanciaKmHasta(Coordenada) double
    }
    class Coordenada {
        <<record>>
        +latitud: double
        +longitud: double
        +distanciaKmHasta(Coordenada) double
    }
    class Rareza {
        <<enumeration>>
        COMUN
        RARA
        LEGENDARIA
        +puntosBase() int
    }
    Usuario <|-- Cazador
    Usuario <|-- Administrador
    CocinaFantasma *-- "1" Ubicacion : ubicacion
    CocinaFantasma --> "1" Rareza : rareza
    CocinaFantasma ..> Builder : builder()
    Builder ..> CocinaFantasma : build()
    Ubicacion ..> Coordenada : usa
    style CocinaFantasma fill:#FFE7B8,stroke:#D98B1C,stroke-width:2px
    style Builder fill:#FFE7B8,stroke:#D98B1C,stroke-width:2px
